<!-- asteroid NMVA.lay -->	   
	   
<mamelayout version="2">
	<element name="nmva_widescreen">
		<image file="asteroid_nmva_ws.png" alphafile="mask_1280_720_horiz.png" />
	</element>
	<element name="nmva_widescreen1" defstate="1">
		<image file="asteroid_nmva_ws1.png" alphafile="mask_1280_720_horiz.png" />
      </element>
	<element name="nmva_widescreen2" defstate="1">
		<image file="asteroid_nmva_ws2.png" alphafile="mask_1280_720_horiz.png" />
      </element>
	<view name="NMVA_Widescreen">
		<bezel element="nmva_widescreen">
			<bounds x="0" y="0" width="1280" height="720" />
		</bezel>
		<screen index="0">
			<bounds x="232" y="54" width="816" height="612" />
		</screen> 
	</view>
	<view name="No Monitor Screen (alt1)">
		<bezel element="nmva_widescreen1">
			<bounds x="0" y="0" width="1280" height="720" />
		</bezel>
		<screen index="0">
			<bounds x="232" y="54" width="816" height="612" />
</screen> 
	</view>
	<view name="Unused (alt2)">
		<bezel element="nmva_widescreen2">
			<bounds x="0" y="0" width="1280" height="720" />
		</bezel>
		<screen index="0">
			<bounds x="232" y="54" width="816" height="612" />

		</screen> 
	</view>
</mamelayout>

